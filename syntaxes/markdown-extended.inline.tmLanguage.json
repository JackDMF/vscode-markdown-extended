{
  "name": "Markdown Extended (Inline)",
  "scopeName": "text.html.markdown.extended.inline",
  "injectionSelector": "text.html.markdown -markup.fenced_code.block.markdown -markup.raw.block.markdown -markup.inline.raw.markdown -markup.math.block.markdown -markup.math.inline.markdown -meta.embedded.block",
  "patterns": [
    {
      "include": "#extended_marks"
    }
  ],
  "repository": {
    "extended_marks": {
      "patterns": [
        {
          "include": "#sidenote"
        },
        {
          "include": "#marginal_note"
        },
        {
          "include": "#left_sidebar"
        },
        {
          "include": "#right_sidebar"
        },
        {
          "include": "#highlight"
        },
        {
          "include": "#toc"
        },
        {
          "include": "#wiki_embed"
        },
        {
          "include": "#kbd"
        },
        {
          "include": "#superscript"
        },
        {
          "include": "#subscript"
        },
        {
          "include": "#footnote_reference"
        },
        {
          "include": "#attributes"
        }
      ]
    },
    "extended_inline": {
      "patterns": [
        {
          "include": "#extended_marks"
        },
        {
          "include": "#multiline_bold"
        },
        {
          "include": "#multiline_italic"
        },
        {
          "include": "text.html.markdown#inline"
        }
      ]
    },
    "sidenote": {
      "name": "markup.sidenote.markdown",
      "match": "\\+\\+(\\S.*?)\\|(.*?\\S?)\\+\\+",
      "captures": {
        "0": {
          "name": "markup.sidenote.container.markdown"
        },
        "1": {
          "name": "markup.sidenote.reference.markdown",
          "patterns": [
            {
              "include": "#extended_inline"
            }
          ]
        },
        "2": {
          "name": "markup.sidenote.content.markdown",
          "patterns": [
            {
              "include": "#extended_inline"
            }
          ]
        }
      }
    },
    "marginal_note": {
      "name": "markup.marginalnote.markdown",
      "match": "(?<![^\\s])!!(\\S.*?)\\|(.*?\\S?)!!(?![^\\s])",
      "captures": {
        "0": {
          "name": "markup.marginalnote.container.markdown"
        },
        "1": {
          "name": "markup.marginalnote.reference.markdown",
          "patterns": [
            {
              "include": "#extended_inline"
            }
          ]
        },
        "2": {
          "name": "markup.marginalnote.content.markdown",
          "patterns": [
            {
              "include": "#extended_inline"
            }
          ]
        }
      }
    },
    "left_sidebar": {
      "name": "markup.leftsidebar.markdown",
      "match": "\\$(\\S(?:.*?\\S)?)\\$",
      "captures": {
        "0": {
          "name": "markup.leftsidebar.container.markdown"
        },
        "1": {
          "name": "markup.leftsidebar.content.markdown",
          "patterns": [
            {
              "include": "#extended_inline"
            }
          ]
        }
      }
    },
    "right_sidebar": {
      "name": "markup.rightsidebar.markdown",
      "match": "@(\\S(?:.*?\\S)?)@",
      "captures": {
        "0": {
          "name": "markup.rightsidebar.container.markdown"
        },
        "1": {
          "name": "markup.rightsidebar.content.markdown",
          "patterns": [
            {
              "include": "#extended_inline"
            }
          ]
        }
      }
    },
    "highlight": {
      "name": "markup.highlight.markdown",
      "match": "(?<!=)==(?![\\s=])((?:[^=\\n]|=(?!=))+?)(?<![\\s=])==(?!=)",
      "captures": {
        "0": {
          "name": "markup.highlight.container.markdown"
        },
        "1": {
          "name": "markup.highlight.content.markdown",
          "patterns": [
            {
              "include": "#extended_inline"
            }
          ]
        }
      }
    },
    "wiki_embed": {
      "comment": "The shape src/plugin/markdownItWikiEmbed.ts reads (WIKI_EMBED_MARKERS): `![[`, a name with no bracket and no line break, `]]`. It starts one character before a key would, so a key never starts inside it. No lookbehind for a backslash: the host grammar's escape takes `\\!` first, and `\\\\` before a bare `!`, which counts them as the parser does. Where it disagrees with the preview: (1) `![[x]](y)` and `![[x]][ref]` are scoped as images, because the host grammar's image rules start at the same `!` and win over this injection there (the preview reads the embed and the text after it); (2) after a marginal note closed by `!!` with no space after it, which the marginal_note rule here does not take, its last `!` opens an embed (`!!ref|note!![[Ctrl]]` is a key in the preview).",
      "name": "meta.embed.wiki.markdown",
      "match": "!\\[\\[[^\\[\\]]+\\]\\]"
    },
    "kbd": {
      "name": "markup.kbd.markdown",
      "match": "\\[\\[(\\S(?:.*?\\S)?)\\]\\]",
      "captures": {
        "0": {
          "name": "markup.kbd.container.markdown"
        },
        "1": {
          "name": "markup.kbd.content.markdown",
          "patterns": [
            {
              "include": "text.html.markdown#inline"
            }
          ]
        }
      }
    },
    "subscript": {
      "name": "markup.subscript.markdown",
      "match": "(?<!~)~(?!~)((?:\\\\.|[^~\\n])+?)~(?!~)",
      "captures": {
        "0": {
          "name": "markup.subscript.container.markdown"
        },
        "1": {
          "name": "markup.subscript.content.markdown"
        }
      }
    },
    "superscript": {
      "name": "markup.superscript.markdown",
      "match": "\\^((?:\\\\.|[^\\^\\n])+?)\\^",
      "captures": {
        "0": {
          "name": "markup.superscript.container.markdown"
        },
        "1": {
          "name": "markup.superscript.content.markdown"
        }
      }
    },
    "toc": {
      "name": "markup.toc.markdown",
      "match": "\\[\\[(?i:TOC)\\]\\]"
    },
    "footnote_reference": {
      "name": "markup.footnote.reference.markdown",
      "match": "\\[\\^([0-9]+)\\](?!:)",
      "captures": {
        "1": {
          "name": "constant.numeric.footnote.markdown"
        }
      }
    },
    "attributes": {
      "name": "meta.attributes.markdown",
      "match": "(\\{)\\s*((?:[.#][\\w-]+|[\\w-]+=(?:\"[^\"\\n]*\"|'[^'\\n]*'|[^\\s}]+))(?:\\s+(?:[.#][\\w-]+|[\\w-]+=(?:\"[^\"\\n]*\"|'[^'\\n]*'|[^\\s}]+)))*)\\s*(\\})",
      "captures": {
        "1": {
          "name": "punctuation.definition.attributes.begin.markdown"
        },
        "2": {
          "patterns": [
            {
              "match": "[.#][\\w-]+",
              "name": "entity.other.attribute-name.class.markdown"
            },
            {
              "match": "([\\w-]+)(=)(\"[^\"\\n]*\"|'[^'\\n]*'|[^\\s}]+)",
              "captures": {
                "1": {
                  "name": "entity.other.attribute-name.markdown"
                },
                "2": {
                  "name": "punctuation.separator.key-value.markdown"
                },
                "3": {
                  "name": "string.quoted.attribute-value.markdown"
                }
              }
            }
          ]
        },
        "3": {
          "name": "punctuation.definition.attributes.end.markdown"
        }
      }
    },
    "multiline_bold": {
      "name": "markup.bold.markdown",
      "begin": "((?<!\\w)\\*\\*(?=\\w)|(?<!\\w)\\b__(?=\\w))",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.bold.markdown"
        }
      },
      "end": "(?<=\\S)(\\1)|^(?<!\\n)(?=\\s*$)|^(?=\\s{0,3}(?:#{1,6}[ \\t]|>|```|~~~|:::|!!![ \\t]|[-+*][ \\t]|\\d+[.)][ \\t]|\\|))",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.bold.markdown"
        }
      },
      "patterns": [
        {
          "include": "#extended_inline"
        }
      ]
    },
    "multiline_italic": {
      "name": "markup.italic.markdown",
      "begin": "((?<![\\w*])\\*(?!\\*)(?=\\w)|(?<!\\w)\\b_(?!_)(?=\\w))",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.italic.markdown"
        }
      },
      "end": "(?<=\\S)(\\1)((?!\\1)|(?=\\1\\1))|^(?<!\\n)(?=\\s*$)|^(?=\\s{0,3}(?:#{1,6}[ \\t]|>|```|~~~|:::|!!![ \\t]|[-+*][ \\t]|\\d+[.)][ \\t]|\\|))",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.italic.markdown"
        }
      },
      "patterns": [
        {
          "include": "#extended_inline"
        }
      ]
    }
  }
}
