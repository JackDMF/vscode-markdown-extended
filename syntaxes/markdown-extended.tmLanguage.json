{
  "name": "Markdown Extended (Blocks)",
  "scopeName": "text.html.markdown.extended",
  "injectionSelector": "L:text.html.markdown -markup.fenced_code.block.markdown -markup.raw.block.markdown -markup.math.block.markdown -markup.math.inline.markdown -meta.embedded.block",
  "patterns": [
    {
      "include": "#admonition"
    },
    {
      "include": "#container_fence"
    },
    {
      "include": "#footnote_definition"
    },
    {
      "include": "#abbr_definition"
    },
    {
      "include": "#deflist_marker"
    },
    {
      "include": "#checkbox"
    },
    {
      "include": "#footnote_reference_midline"
    }
  ],
  "repository": {
    "admonition": {
      "name": "markup.admonition.markdown",
      "begin": "^\\s*(!!!)(\\s+)(note|summary|abstract|tldr|info|todo|tip|hint|success|check|done|question|help|faq|warning|attention|caution|failure|fail|missing|danger|error|bug|example|snippet|quote|cite)(?:(\\s+)(.+?))?$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.admonition.markdown"
        },
        "2": {
          "name": "markup.admonition.markdown"
        },
        "3": {
          "name": "entity.name.admonition.qualifier.markdown"
        },
        "4": {
          "name": "markup.admonition.markdown"
        },
        "5": {
          "name": "entity.name.admonition.title.markdown"
        }
      },
      "patterns": [
        {
          "include": "#checkbox"
        },
        {
          "match": "^\\s{4,}(>)\\s*(#{1,6})\\s+(.*)$",
          "captures": {
            "1": {
              "name": "punctuation.definition.quote.begin.markdown"
            },
            "2": {
              "name": "punctuation.definition.heading.markdown"
            },
            "3": {
              "name": "markup.heading.markdown",
              "patterns": [
                {
                  "include": "text.html.markdown.extended.inline#extended_inline"
                }
              ]
            }
          }
        },
        {
          "match": "^\\s{4,}(>)\\s?(.*)$",
          "captures": {
            "1": {
              "name": "punctuation.definition.quote.begin.markdown"
            },
            "2": {
              "name": "markup.quote.markdown",
              "patterns": [
                {
                  "include": "text.html.markdown.extended.inline#extended_inline"
                }
              ]
            }
          }
        },
        {
          "match": "^\\s{4,}([-*+]|\\d+[.)])(?=\\s)",
          "captures": {
            "1": {
              "name": "punctuation.definition.list.begin.markdown"
            }
          }
        },
        {
          "include": "#admonition"
        },
        {
          "include": "text.html.markdown.extended.inline#extended_inline"
        }
      ],
      "end": "^(?=\\s{0,3}\\S)",
      "contentName": "markup.admonition.content.markdown"
    },
    "container_fence": {
      "match": "^\\s*(:{3,})\\s*([\\w-]+(?:[ \\t]+[\\w-]+)*)?\\s*$",
      "captures": {
        "1": {
          "name": "punctuation.definition.container.markdown"
        },
        "2": {
          "name": "entity.name.container.qualifier.markdown"
        }
      }
    },
    "footnote_definition": {
      "match": "^\\s*(\\[\\^)([0-9]+)(\\]:)",
      "name": "markup.footnote.definition.markdown",
      "captures": {
        "1": {
          "name": "punctuation.definition.footnote.markdown"
        },
        "2": {
          "name": "constant.numeric.footnote.markdown"
        },
        "3": {
          "name": "punctuation.definition.footnote.markdown"
        }
      }
    },
    "abbr_definition": {
      "match": "^\\s*(\\*\\[)([^\\]\\n]+)(\\]:)(.*)$",
      "name": "markup.abbr.definition.markdown",
      "captures": {
        "1": {
          "name": "punctuation.definition.abbr.markdown"
        },
        "2": {
          "name": "entity.name.abbreviation.markdown"
        },
        "3": {
          "name": "punctuation.definition.abbr.markdown"
        },
        "4": {
          "name": "markup.abbr.title.markdown"
        }
      }
    },
    "deflist_marker": {
      "match": "^\\s*(:)(?=[ \\t])",
      "captures": {
        "1": {
          "name": "punctuation.definition.list.begin.markdown"
        }
      }
    },
    "footnote_reference_midline": {
      "name": "markup.footnote.reference.markdown",
      "match": "(?<=[^\\n])\\[\\^([0-9]+)\\](?!:)",
      "captures": {
        "1": {
          "name": "constant.numeric.footnote.markdown"
        }
      }
    },
    "checkbox": {
      "name": "markup.checkbox.markdown",
      "match": "^\\s*-\\s+\\[([ xX])\\]",
      "captures": {
        "1": {
          "name": "constant.other.checkbox.state.markdown"
        }
      }
    }
  }
}
