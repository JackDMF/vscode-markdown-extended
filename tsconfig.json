{
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2022",
        "outDir": "out",
        "lib": [
            "dom",
            "es6",
            "es2022.intl"
        ],
        "sourceMap": true,
        "rootDir": ".",
        "typeRoots": [
            "node_modules/@types",
            "src/@types"
        ],
        // prosemirror-markdown depends on @types/markdown-it, which would otherwise
        // shadow the project's own declarations in src/@types for every
        // `from 'markdown-it'` import and break the plugins and their tests.
        "paths": {
            "markdown-it": ["./src/@types/markdown-it"]
        },
        
        // Gradual strict mode - enable more as code improves
        "strict": false,
        "noImplicitAny": false,
        "strictNullChecks": false,
        
        // Practical checks we can enforce now
        "noFallthroughCasesInSwitch": true,
        "forceConsistentCasingInFileNames": true,
        
        // Module Resolution
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true
    },
    "exclude": [
        "node_modules",
        ".vscode-test",
        "out"
    ]
}